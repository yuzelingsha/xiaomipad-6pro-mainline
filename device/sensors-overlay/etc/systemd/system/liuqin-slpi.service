[Unit]
Description=liuqin sensor processor lifecycle
# Local opt-out for units on which starting SLPI resets the tablet.
ConditionPathExists=!/etc/liuqin-slpi-disabled
After=systemd-udevd.service systemd-tmpfiles-setup.service
Before=liuqin-hexagonrpcd-sdsp.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-slpi start
ExecStop=/usr/local/sbin/liuqin-slpi stop
RemainAfterExit=yes
TimeoutStartSec=20s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
