#!/sbin/sh
# SPDX-License-Identifier: MIT
# This module is meant to be installed from the KernelSU manager, which
# extracts the zip itself.  Recovery sideload is not supported: it would place
# the files outside KernelSU's module directory.
ui_print() { echo "ui_print $1" > /proc/self/fd/"$2"; echo "ui_print" > /proc/self/fd/"$2"; }
ui_print "! Install this module from the KernelSU manager, not from recovery." "$2"
exit 1
