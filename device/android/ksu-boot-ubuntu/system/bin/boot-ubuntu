#!/system/bin/sh
# SPDX-License-Identifier: MIT
#
# Android -> Ubuntu on liuqin: a thin wrapper around `liuqin-switch
# to-ubuntu`, the same switcher the Ubuntu side runs.  Both systems boot from
# slot A; the switch writes the Ubuntu boot image into boot_a, reads it back
# and reboots.  It never changes the active slot.
#
# The switcher ships next to this script.  Whether /system/bin is where it is
# found at run time depends on KernelSU mounting the module's system/ over
# /system; the module directory is a real path either way.
set -u

module_dir=/data/adb/modules/liuqin_boot_ubuntu
switch=${0%/*}/liuqin-switch
[ -f "$switch" ] || switch=$module_dir/system/bin/liuqin-switch

log_dir=/data/adb/ksu/log
[ -d "$log_dir" ] || log_dir=$module_dir
log_file=$log_dir/liuqin-switch.log

usage() {
	echo 'usage: boot-ubuntu [-y] [-n]'
	echo '  -y  do not ask for confirmation'
	echo '  -n  report what would be written; write nothing and do not reboot'
}

die() { echo "boot-ubuntu: $*" >&2; exit 1; }

assume_yes=0
dry_run=0
for arg in "$@"; do
	case $arg in
	-y) assume_yes=1 ;;
	-n|--dry-run) dry_run=1 ;;
	-h|--help) usage; exit 0 ;;
	*) usage >&2; exit 64 ;;
	esac
done

[ "$(id -u)" = 0 ] || die 'must run as root (su -c boot-ubuntu)'
[ -f "$switch" ] || die "liuqin-switch is missing: $switch"

# The switcher appends here while the Ubuntu store is mounted read-only; keep
# the file bounded, it lives for as long as the module does.
if [ -f "$log_file" ] && [ "$(wc -c <"$log_file" 2>/dev/null || echo 0)" -gt 65536 ]; then
	tail -c 16384 "$log_file" >"$log_file.trim" 2>/dev/null && mv -f "$log_file.trim" "$log_file"
fi
export LIUQIN_SWITCH_LOG="$log_file"

if [ "$dry_run" = 1 ]; then
	exec sh "$switch" to-ubuntu --dry-run
fi

if [ "$assume_yes" != 1 ]; then
	printf 'Write the Ubuntu boot image into boot_a and reboot now? [y/N] '
	read -r answer || answer=
	case $answer in y|Y|yes|YES) ;; *) echo 'boot-ubuntu: cancelled'; exit 0 ;; esac
fi

exec sh "$switch" to-ubuntu
